<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Covers the whole of Environment.getExternalStorageDirectory()
         needed because Settings.defaultSaveLocation() (Settings screen's
         folder picker) and QueueItem.customSaveDirPath (per-download
         "Change" button) can now point at any folder under primary
         external storage, not just the app's own Xmd/<Category>. Root
         path ("") covers every subfolder underneath it, including the
         previous fixed Xmd/ and Download/ locations. -->
    <external-path name="xmd_files" path="." />

    <!-- Torrent temp/staging paths under app-private storage, just in case
         a completed item's fileName ever resolves under here instead. -->
    <cache-path name="xmd_cache" path="." />
</paths>
