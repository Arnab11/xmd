<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Address bar: gesture back handles page/tab navigation now, so no
             back/forward buttons; just new-tab, the search field, reload,
             tabs, and overflow. Floats slightly off the edges with its own
             rounded surface + elevation (rather than a flat bar flush with
             the screen edges) for the Expressive "floating toolbar" look.

             Phase E: this whole row (home/address-pill/new-tab/tabs/
             overflow buttons, plus the progress line overlapping the
             card's bottom edge) is now a single ComposeView hosting
             BrowserToolbarRow (see BrowserToolbar.kt), replacing what was
             a MaterialCardView + nested LinearLayout/EditText/ImageButtons
             plus a separate LinearProgressIndicator sibling. Same wrap_content
             height, same position as the first child of this vertical
             LinearLayout, so the WebView content area below is unaffected. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/browserToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Content area: WebView underneath, speed-dial shown on top for new tab -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Hosts every live tab's own WebView instance (pooled, capped;
                 see BrowserFragment). Each tab's WebView is added here and
                 shown/hidden (with a crossfade) on switch instead of a single
                 shared WebView being re-pointed, so switching tabs is an
                 instant view swap rather than a reload/restoreState.

                 Wrapped in SwipeRefreshLayout for Chrome-style pull-to-
                 refresh; BrowserFragment gates the gesture to only fire
                 when the active WebView is already scrolled to the top
                 (setOnChildScrollUpCallback), same as Chrome. -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/webViewSwipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/webViewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- Speed-dial "new tab" page: ShortcutsScreen (see
                 ShortcutsScreen.kt), set up in BrowserFragment.onViewCreated.
                 Same id/visibility contract as before: showSpeedDial()/
                 showWebView() just flip this VISIBLE/GONE. -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/speedDialContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/colorBackground"
                android:visibility="visible" />

            <!-- Address-bar suggestions dropdown: floats over WebView/speed-dial
                 while the user is typing; hidden otherwise. Phase 5: now a
                 ComposeView hosting AddressBarSuggestions (was a
                 MaterialCardView wrapping a RecyclerView + SuggestionAdapter);
                 same id, same top+8dp-margin position. The composable
                 renders nothing (zero height) when its suggestion list is
                 empty, replacing the old visibility="gone" default. -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/suggestionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="8dp" />

            <!-- Find-in-page overlay: Chrome-style search bar that floats over
                 the WebView/speed-dial while active, hidden otherwise. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/findInPageBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:shapeAppearance="@style/ShapeAppearance.Xmd.Medium"
                app:cardElevation="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="4dp"
                    android:paddingVertical="4dp">

                    <EditText
                        android:id="@+id/findInPageInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/find_in_page_hint"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        android:inputType="text" />

                    <TextView
                        android:id="@+id/findInPageMatchCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="0/0"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/findInPagePrev"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_up"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@string/find_in_page_prev" />

                    <ImageButton
                        android:id="@+id/findInPageNext"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_down"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@string/find_in_page_next" />

                    <ImageButton
                        android:id="@+id/findInPageClose"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        android:src="@drawable/ic_close"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@string/action_dismiss" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation loading veil: shown the instant a new page starts
                 loading (new URL, back/forward, tab switch) and hidden once
                 it finishes. Sits above the WebView so the *previous* page's
                 pixels are never visible mid-navigation, without this,
                 WebView keeps rendering the old page until the new one has
                 painted, which reads as "purana website dikh raha hai". -->
            <FrameLayout
                android:id="@+id/navLoadingVeil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/colorBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="?attr/colorPrimary" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Video/audio sniffer chip: appears with a live count when MediaSniffer
         picks up a stream on the current page. Sits above addLinkFab so both
         can be visible at once without overlapping. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/sniffedMediaFab"
        style="@style/Widget.Xmd.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="88dp"
        app:icon="@drawable/ic_video"
        android:visibility="gone" />

    <!-- Auto-detect FAB: appears when a downloadable link is found on the page -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addLinkFab"
        style="@style/Widget.Xmd.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@drawable/ic_download_link"
        android:contentDescription="@string/action_add_to_downloads"
        android:visibility="gone" />

    <!-- Phase 5: host for Browser's Compose-native dialogs/sheets
         (SniffedMediaSheet first, more to follow as the rest of this
         Fragment's chrome converts); unlike speedDialContainer this
         isn't a visible content area, just a composition root. Sized
         match_parent because ModalBottomSheet/AlertDialog render in
         their own Dialog window regardless of this host's own bounds. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/browserDialogHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Phase 5: tabs tray, Compose-native (TabsListOverlay.kt). Was a
         BottomSheetDialog built in showTabsDialog(); now a full-bleed
         overlay, real on-screen bounds anchored here, not a Dialog
         window, topmost so it covers the FABs and browserDialogHost's
         dialogs too, same as the old dialog visually sat above everything. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/tabsListOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
