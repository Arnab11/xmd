<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <RadioGroup
        android:id="@+id/dnsModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/dnsOptionAdguard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dns_mode_adguard"
            android:textColor="@color/ff_text"
            android:paddingVertical="8dp" />

        <RadioButton
            android:id="@+id/dnsOptionOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dns_mode_off"
            android:textColor="@color/ff_text"
            android:paddingVertical="8dp" />

        <RadioButton
            android:id="@+id/dnsOptionCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dns_mode_custom"
            android:textColor="@color/ff_text"
            android:paddingVertical="8dp" />
    </RadioGroup>

    <EditText
        android:id="@+id/dnsCustomUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/dns_custom_url_hint"
        android:textColorHint="@color/ff_muted"
        android:textColor="@color/ff_text"
        android:inputType="textUri"
        android:singleLine="true"
        android:visibility="gone" />

</LinearLayout>
